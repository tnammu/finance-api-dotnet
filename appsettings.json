{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "FinanceApi": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=dividends.db;Cache=Shared;Mode=ReadWriteCreate"
  },
  "AlphaVantage": {
    "ApiKey": "YOUR_ALPHAVANTAGE_API_KEY"
  },
  "Reddit": {
    "ClientId": "YOUR_REDDIT_CLIENT_ID",
    "ClientSecret": "YOUR_REDDIT_CLIENT_SECRET",
    "UserAgent": "FinanceAPI:RedditSentiment:v1.0"
  },
  "Sms": {
    "NtfyTopic":    "YOUR_NTFY_STOCK_TOPIC",
    "OilNtfyTopic": "YOUR_NTFY_OIL_TOPIC",
    "NtfyServer":   "https://ntfy.sh"
  },
  "AlertSchedule": {
    "Enabled": true,
    "Times": ["09:30", "14:00"],
    "Timezone": "Eastern Standard Time"
  }}